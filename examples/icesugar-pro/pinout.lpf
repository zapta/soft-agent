# iCESugar Pro pins for main.v.

# 25 MHz clock.
LOCATE COMP "sys_clk" SITE "P6";
IOBUF PORT "sys_clk" IO_TYPE=LVCMOS33;

# The user LED, active low.
LOCATE COMP "led" SITE "A11";
IOBUF PORT "led" IO_TYPE=LVCMOS33;

# The debugger's UART (pins B9 and A9) is added by the debug build:
# don't use those pins here.
